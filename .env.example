# Необязательные настройки системной установки 3X-UI.
# Сервис считывает их из /etc/default/x-ui, /etc/conf.d/x-ui
# или /etc/sysconfig/x-ui в зависимости от дистрибутива.
# Укажите только те параметры, которые необходимо переопределить.

#XUI_DB_TYPE=sqlite
#XUI_DB_FOLDER=/etc/x-ui
#XUI_DB_DSN=
#XUI_DB_MAX_OPEN_CONNS=
#XUI_DB_MAX_IDLE_CONNS=

#XUI_PORT=
#XUI_INIT_WEB_BASE_PATH=/
#XUI_ENABLE_FAIL2BAN=true
#XUI_SKIP_HSTS=false

#XUI_LOG_LEVEL=info
#XUI_LOG_FOLDER=/var/log/x-ui
#XUI_BIN_FOLDER=bin
#XUI_MAIN_FOLDER=/usr/local/x-ui
#XUI_SERVICE=/etc/systemd/system

#XUI_MEMORY_LIMIT=
#XUI_MEMORY_RELEASE_INTERVAL=
#XUI_XRAY_MEMORY_LIMIT=
#XUI_PPROF=false

#XRAY_VMESS_AEAD_FORCED=false

package tunnel

import (
	"encoding/binary"
	"io"
	"net"
	"testing"
	"time"
)

// The SOCKS fixture echoes without resolving the deliberately unreachable
// destination. A direct fallback could never pass either round trip.
func TestPanelPayloadEgressTCPAndUDP(t *testing.T) {
	listener, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	defer listener.Close()
	udp, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
	if err != nil {
		t.Fatal(err)
	}
	defer udp.Close()
	seen := make(chan byte, 4)
	go func() {
		buf := make([]byte, 65535)
		for {
			n, from, e := udp.ReadFromUDP(buf)
			if e != nil {
				return
			}
			udp.WriteToUDP(buf[:n], from)
		}
	}()
	go func() {
		for {
			c, e := listener.Accept()
			if e != nil {
				return
			}
			go func() {
				defer c.Close()
				c.SetDeadline(time.Now().Add(5 * time.Second))
				var hello [3]byte
				if _, e := io.ReadFull(c, hello[:]); e != nil {
					return
				}
				c.Write([]byte{5, 0})
				var header [4]byte
				if _, e := io.ReadFull(c, header[:]); e != nil {
					return
				}
				var n int
				switch header[3] {
				case 1:
					n = 6
				case 4:
					n = 18
				case 3:
					var l [1]byte
					io.ReadFull(c, l[:])
					n = int(l[0]) + 2
				default:
					return
				}
				if _, e := io.CopyN(io.Discard, c, int64(n)); e != nil {
					return
				}
				seen <- header[1]
				reply := []byte{5, 0, 0, 1, 127, 0, 0, 1, 0, 0}
				binary.BigEndian.PutUint16(reply[8:], uint16(udp.LocalAddr().(*net.UDPAddr).Port))
				c.Write(reply)
				if header[1] == 1 {
					io.Copy(c, c)
				} else {
					io.Copy(io.Discard, c)
				}
			}()
		}
	}()
	old := *panelEgress
	*panelEgress = listener.Addr().String()
	defer func() { *panelEgress = old }()
	tcp, err := PanelDialTCP("unreachable.invalid:443")
	if err != nil {
		t.Fatal(err)
	}
	tcp.SetDeadline(time.Now().Add(5 * time.Second))
	tcp.Write([]byte("payload"))
	reply := make([]byte, 7)
	if _, err := io.ReadFull(tcp, reply); err != nil || string(reply) != "payload" {
		t.Fatalf("TCP egress: %q %v", reply, err)
	}
	tcp.Close()
	client, server := net.Pipe()
	client.SetDeadline(time.Now().Add(5 * time.Second))
	defer client.Close()
	done := make(chan error, 1)
	go func() { done <- HandleUoTServer(server) }()
	writer := NewUoTWriter(client, func(error) { client.Close() })
	defer writer.Close()
	if err := writer.WriteDatagram("unreachable.invalid:53", []byte("dns-payload")); err != nil {
		t.Fatal(err)
	}
	reader := NewUoTReader(client)
	address, payload, err := reader.next()
	if err != nil || string(payload) != "dns-payload" || len(address) == 0 || address[0] != 3 {
		t.Fatalf("UDP egress: %v %q %v", address, payload, err)
	}
	client.Close()
	select {
	case <-done:
	case <-time.After(5 * time.Second):
		t.Fatal("UoT did not close")
	}
	for _, want := range []byte{1, 3} {
		select {
		case got := <-seen:
			if got != want {
				t.Fatalf("SOCKS command %d, want %d", got, want)
			}
		case <-time.After(time.Second):
			t.Fatal("missing SOCKS request")
		}
	}
}

func TestPanelPayloadEgressNeverFallsBack(t *testing.T) {
	closed, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	address := closed.Addr().String()
	closed.Close()
	target, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	defer target.Close()
	old := *panelEgress
	*panelEgress = address
	defer func() { *panelEgress = old }()
	if c, err := PanelDialTCP(target.Addr().String()); err == nil {
		c.Close()
		t.Fatal("failed SOCKS silently dialed target directly")
	}
	client, server := net.Pipe()
	defer client.Close()
	done := make(chan error, 1)
	go func() { done <- HandleUoTServer(server) }()
	select {
	case err := <-done:
		if err == nil {
			t.Fatal("failed UDP SOCKS was accepted")
		}
	case <-time.After(3 * time.Second):
		t.Fatal("failed UDP SOCKS did not terminate")
	}
}

// Panel egress extension. The upstream protocol and key formats are unchanged.
package tunnel

import (
	"context"
	"encoding/binary"
	"errors"
	"flag"
	"fmt"
	"io"
	"net"
	"strconv"
	"sync"
	"time"

	"github.com/SUDOKU-ASCII/sudoku/internal/protocol"
	"golang.org/x/net/proxy"
)

var panelEgress = flag.String("panel-egress", "", "Required loopback SOCKS5 payload router (no direct fallback)")

func PanelDialTCP(address string) (net.Conn, error) {
	if *panelEgress == "" {
		return net.DialTimeout("tcp", address, 10*time.Second)
	}
	dialer, err := proxy.SOCKS5("tcp", *panelEgress, nil, &net.Dialer{Timeout: 10 * time.Second})
	if err != nil {
		return nil, err
	}
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	return dialer.(proxy.ContextDialer).DialContext(ctx, "tcp", address)
}

func panelUDPAssociate() (net.Conn, *net.UDPConn, error) {
	ctrl, err := net.DialTimeout("tcp", *panelEgress, 10*time.Second)
	if err != nil {
		return nil, nil, err
	}
	fail := func(err error) (net.Conn, *net.UDPConn, error) { ctrl.Close(); return nil, nil, err }
	ctrl.SetDeadline(time.Now().Add(10 * time.Second))
	if _, err = ctrl.Write([]byte{5, 1, 0}); err != nil {
		return fail(err)
	}
	var greeting [2]byte
	if _, err = io.ReadFull(ctrl, greeting[:]); err != nil {
		return fail(err)
	}
	if greeting != [2]byte{5, 0} {
		return fail(errors.New("payload SOCKS router rejected no-auth negotiation"))
	}
	if _, err = ctrl.Write([]byte{5, 3, 0, 1, 0, 0, 0, 0, 0, 0}); err != nil {
		return fail(err)
	}
	var reply [4]byte
	if _, err = io.ReadFull(ctrl, reply[:]); err != nil {
		return fail(err)
	}
	if reply[0] != 5 || reply[1] != 0 || reply[2] != 0 {
		return fail(fmt.Errorf("SOCKS UDP ASSOCIATE failed: %v", reply))
	}
	var host string
	switch reply[3] {
	case 1:
		b := make([]byte, 4)
		if _, err = io.ReadFull(ctrl, b); err != nil {
			return fail(err)
		}
		host = net.IP(b).String()
	case 4:
		b := make([]byte, 16)
		if _, err = io.ReadFull(ctrl, b); err != nil {
			return fail(err)
		}
		host = net.IP(b).String()
	case 3:
		var n [1]byte
		if _, err = io.ReadFull(ctrl, n[:]); err != nil {
			return fail(err)
		}
		b := make([]byte, int(n[0]))
		if _, err = io.ReadFull(ctrl, b); err != nil {
			return fail(err)
		}
		host = string(b)
	default:
		return fail(errors.New("invalid SOCKS relay address"))
	}
	var port [2]byte
	if _, err = io.ReadFull(ctrl, port[:]); err != nil {
		return fail(err)
	}
	if ip := net.ParseIP(host); ip != nil && ip.IsUnspecified() {
		host = ctrl.RemoteAddr().(*net.TCPAddr).IP.String()
	}
	target, err := net.ResolveUDPAddr("udp", net.JoinHostPort(host, strconv.Itoa(int(binary.BigEndian.Uint16(port[:])))))
	if err != nil {
		return fail(err)
	}
	udp, err := net.DialUDP("udp", nil, target)
	if err != nil {
		return fail(err)
	}
	ctrl.SetDeadline(time.Time{})
	return ctrl, udp, nil
}

func panelAddressLength(data []byte) (int, error) {
	if len(data) == 0 {
		return 0, io.ErrUnexpectedEOF
	}
	var n int
	switch data[0] {
	case 1:
		n = 7
	case 4:
		n = 19
	case 3:
		if len(data) < 2 {
			return 0, io.ErrUnexpectedEOF
		}
		n = 4 + int(data[1])
	default:
		return 0, errors.New("invalid SOCKS datagram address")
	}
	if len(data) < n {
		return 0, io.ErrUnexpectedEOF
	}
	return n, nil
}

func panelHandleUoT(conn net.Conn) error {
	ctrl, udp, err := panelUDPAssociate()
	if err != nil {
		conn.Close()
		return err
	}
	done := make(chan error, 1)
	var once sync.Once
	finish := func(err error) { once.Do(func() { ctrl.Close(); udp.Close(); conn.Close(); done <- err }) }
	writer := NewUoTWriter(conn, finish)
	defer writer.Close()
	go func() { var b [1]byte; _, err := ctrl.Read(b[:]); finish(err) }()
	go func() {
		buf := make([]byte, 65535)
		for {
			n, err := udp.Read(buf)
			if err != nil {
				finish(err)
				return
			}
			if n < 4 || buf[0] != 0 || buf[1] != 0 || buf[2] != 0 {
				continue
			}
			length, err := panelAddressLength(buf[3:n])
			if err != nil {
				continue
			}
			address, err := protocol.DecodeAddress(buf[3 : 3+length])
			if err != nil {
				continue
			}
			if err = writer.WriteDatagram(address, buf[3+length:n]); err != nil {
				finish(err)
				return
			}
		}
	}()
	reader := NewUoTReader(conn)
	for {
		address, payload, err := reader.next()
		if err != nil {
			finish(err)
			break
		}
		if _, err = panelAddressLength(address); err != nil {
			finish(err)
			break
		}
		packet := make([]byte, 3, 3+len(address)+len(payload))
		packet = append(packet, address...)
		packet = append(packet, payload...)
		if _, err = udp.Write(packet); err != nil {
			finish(err)
			break
		}
	}
	return <-done
}

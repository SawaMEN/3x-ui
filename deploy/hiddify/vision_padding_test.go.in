package vless

import (
	"encoding/binary"
	"github.com/sagernet/sing/common/buf"
	"github.com/sagernet/sing/common/logger"
	"testing"
)

func TestXUIPanelVisionPadding(t *testing.T) {
	seed, err := ValidateVisionTestseed([]uint32{900, 1, 1000, 1})
	if err != nil {
		t.Fatal(err)
	}
	sender := &VisionConn{testseed: seed, isTLS: true, writeUUID: true, userUUID: [16]byte{1}, logger: logger.NOP()}
	frame := sender.padding(buf.As([]byte("payload")), commandPaddingContinue)
	defer frame.Release()
	bytes := frame.Bytes()
	if binary.BigEndian.Uint16(bytes[17:19]) != 7 || binary.BigEndian.Uint16(bytes[19:21]) != 993 {
		t.Fatalf("wrong frame lengths: %x", bytes[:21])
	}
	receiver := &VisionConn{userUUID: [16]byte{1}, remainingContent: -1, remainingPadding: -1, logger: logger.NOP()}
	parts := receiver.unPadding(bytes)
	if len(parts) != 1 || string(parts[0].Bytes()) != "payload" {
		t.Fatal("padding corrupted data")
	}
	for _, p := range parts {
		p.Release()
	}
	for _, invalid := range [][]uint32{{1}, {900, 0, 900, 256}, {900, 1, 1, 256}, {900, 65535, 900, 256}, {900, 500, 900, 65537}} {
		if _, err := ValidateVisionTestseed(invalid); err == nil {
			t.Fatalf("accepted invalid seed %v", invalid)
		}
	}
}

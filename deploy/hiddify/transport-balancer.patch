+package group
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	M "github.com/sagernet/sing/common/metadata"
+	"math"
+	"net"
+	"net/url"
+	"os"
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json/badoption"
+	"github.com/sagernet/sing/service"
+	"github.com/xtls/xray-core/app/observatory"
+	XR "github.com/xtls/xray-core/app/router"
+	"github.com/xtls/xray-core/features/extension"
+	"google.golang.org/protobuf/proto"
+)
+
+type balanceState struct {
+	history         *urltest.HistoryStorage
+	started, closed bool
+	ctx             context.Context
+	cancel          context.CancelFunc
+	strategy        XR.BalancingStrategy
+	config          option.XrayBalancerOptions
+	mu              sync.RWMutex
+	reports         map[string]*observatory.OutboundStatus
+	samples         map[string][]probeSample
+	targets         map[string]adapter.Outbound
+	wg              sync.WaitGroup
+}
+type probeSample struct {
+	delay  time.Duration
+	failed bool
+}
+
+func newBalanceState(ctx context.Context, o option.XrayBalancerOptions) (*balanceState, error) {
+	o.Strategy = strings.ToLower(o.Strategy)
+	if o.Strategy == "" {
+		o.Strategy = "random"
+	}
+	if o.Interval <= 0 {
+		o.Interval = badoption.Duration(300 * time.Second)
+	}
+	if o.Timeout <= 0 {
+		o.Timeout = badoption.Duration(10 * time.Second)
+	}
+	if o.Sampling == 0 {
+		o.Sampling = 5
+	}
+	if o.Interval.Build() > time.Duration(math.MaxInt64)/time.Duration(o.Sampling)/2 || o.Sampling > 64 || o.Interval.Build() < time.Second || o.Timeout.Build() < time.Millisecond {
+		return nil, fmt.Errorf("invalid balancing probe limits")
+	}
+	for _, link := range []string{o.ProbeURL, o.Connectivity} {
+		if link != "" {
+			u, err := url.Parse(link)
+			if err != nil || u.Hostname() == "" || u.Scheme != "http" && u.Scheme != "https" {
+				return nil, fmt.Errorf("invalid balancing probe URL")
+			}
+		}
+	}
+	if (o.Strategy == "leastping" || o.Strategy == "leastload" || o.Fallback != "") && o.ProbeURL == "" {
+		return nil, fmt.Errorf("health balancing requires an explicit probe_url")
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	state := &balanceState{history: service.PtrFromContext[urltest.HistoryStorage](ctx), ctx: ctx, cancel: cancel, config: o, reports: map[string]*observatory.OutboundStatus{}, samples: map[string][]probeSample{}}
+	switch o.Strategy {
+	case "random":
+		state.strategy = &XR.RandomStrategy{FallbackTag: o.Fallback}
+	case "roundrobin":
+		state.strategy = &XR.RoundRobinStrategy{FallbackTag: o.Fallback}
+	case "leastping":
+		state.strategy = &XR.LeastPingStrategy{}
+	case "leastload":
+		raw := json.RawMessage(o.Settings)
+		if len(raw) == 0 {
+			raw = []byte("{}")
+		}
+		settings, err := XR.ParseSingBoxLeastLoadSettings(raw)
+		if err != nil {
+			cancel()
+			return nil, err
+		}
+		for _, cost := range settings.Costs {
+			if cost == nil {
+				cancel()
+				return nil, fmt.Errorf("leastLoad costs must be objects")
+			}
+			if cost.Regexp {
+				if _, err := regexp.Compile(cost.Match); err != nil {
+					cancel()
+					return nil, err
+				}
+			}
+		}
+		state.strategy = XR.NewLeastLoadStrategy(settings)
+	default:
+		cancel()
+		return nil, fmt.Errorf("unknown balancing strategy %s", o.Strategy)
+	}
+	if err := XR.BindSingBoxObserver(state.strategy, ctx, state); err != nil {
+		cancel()
+		return nil, err
+	}
+	return state, nil
+}
+func (b *balanceState) Type() any    { return extension.ObservatoryType() }
+func (b *balanceState) Start() error { return nil }
+func (b *balanceState) Close() error {
+	b.mu.Lock()
+	b.closed = true
+	b.cancel()
+	b.mu.Unlock()
+	b.wg.Wait()
+	return nil
+}
+func (b *balanceState) GetObservation(context.Context) (proto.Message, error) {
+	b.mu.RLock()
+	defer b.mu.RUnlock()
+	report := &observatory.ObservationResult{}
+	for _, v := range b.reports {
+		copy := proto.Clone(v).(*observatory.OutboundStatus)
+		if b.config.Burst && time.Since(time.Unix(v.LastTryTime, 0)) > b.config.Interval.Build()*time.Duration(b.config.Sampling)*2 {
+			copy.Alive = false
+		}
+		report.Status = append(report.Status, copy)
+	}
+	sort.Slice(report.Status, func(i, j int) bool { return report.Status[i].OutboundTag < report.Status[j].OutboundTag })
+	return report, nil
+}
+func (b *balanceState) pick(tags []string) (string, error) {
+	tag := b.strategy.PickOutbound(tags)
+	if tag == "" {
+		tag = b.config.Fallback
+	}
+	if tag == "" {
+		return "", fmt.Errorf("balancer has no healthy outbound")
+	}
+	return tag, nil
+}
+func (b *balanceState) postStart(targets map[string]adapter.Outbound) {
+	b.mu.Lock()
+	if b.started || b.closed {
+		b.mu.Unlock()
+		return
+	}
+	b.started = true
+	b.targets = targets
+	if b.config.ProbeURL == "" {
+		b.mu.Unlock()
+		return
+	}
+	b.wg.Add(1)
+	b.mu.Unlock()
+	go func() {
+		defer b.wg.Done()
+		b.probe()
+		ticker := time.NewTicker(b.config.Interval.Build())
+		defer ticker.Stop()
+		for {
+			select {
+			case <-b.ctx.Done():
+				return
+			case <-ticker.C:
+				b.probe()
+			}
+		}
+	}()
+}
+func (b *balanceState) probe() {
+	limit := 1
+	if b.config.Concurrent {
+		limit = 4
+	}
+	semaphore := make(chan struct{}, limit)
+	var group sync.WaitGroup
+	for tag, detour := range b.targets {
+		if len(b.config.ProbeTags) > 0 {
+			found := false
+			for _, subject := range b.config.ProbeTags {
+				if subject == tag {
+					found = true
+					break
+				}
+			}
+			if !found {
+				continue
+			}
+		}
+		if tag == b.config.Fallback {
+			continue
+		}
+		select {
+		case semaphore <- struct{}{}:
+		case <-b.ctx.Done():
+			group.Wait()
+			return
+		}
+		group.Add(1)
+		go func(tag string, detour adapter.Outbound) {
+			defer group.Done()
+			defer func() { <-semaphore }()
+			ctx, cancel := context.WithTimeout(b.ctx, b.config.Timeout.Build())
+			delay, err := urltest.URLTestWithMethod(ctx, b.config.ProbeURL, b.config.Method, detour)
+			cancel()
+			if err != nil && b.config.Connectivity != "" {
+				ctx, cancel := context.WithTimeout(b.ctx, b.config.Timeout.Build())
+				_, connectErr := urltest.URLTestWithMethod(ctx, b.config.Connectivity, b.config.Method, directProbeDialer{})
+				cancel()
+				if connectErr != nil {
+					return
+				}
+			}
+			b.record(tag, time.Duration(delay)*time.Millisecond, err)
+		}(tag, detour)
+	}
+	group.Wait()
+}
+
+type directProbeDialer struct{}
+
+func (directProbeDialer) DialContext(ctx context.Context, network string, address M.Socksaddr) (net.Conn, error) {
+	var d net.Dialer
+	return d.DialContext(ctx, network, address.String())
+}
+func (directProbeDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, os.ErrInvalid
+}
+
+func (b *balanceState) record(tag string, delay time.Duration, err error) {
+	b.mu.Lock()
+	samples := append(b.samples[tag], probeSample{delay: delay, failed: err != nil})
+	if len(samples) > int(b.config.Sampling) {
+		samples = samples[len(samples)-int(b.config.Sampling):]
+	}
+	b.samples[tag] = samples
+	health := &observatory.HealthPingMeasurementResult{All: int64(len(samples))}
+	var sum float64
+	var delays []float64
+	for _, s := range samples {
+		if s.failed {
+			health.Fail++
+			continue
+		}
+		sum += float64(s.delay)
+		delays = append(delays, float64(s.delay))
+	}
+	if len(delays) > 0 {
+		mean := sum / float64(len(delays))
+		health.Average = int64(mean)
+		var variance float64
+		for _, d := range delays {
+			variance += (d - mean) * (d - mean)
+		}
+		if len(delays) == 1 {
+			health.Deviation = int64(mean / 2)
+		} else {
+			health.Deviation = int64(math.Sqrt(variance / float64(len(delays)-1)))
+		}
+	}
+	report := &observatory.OutboundStatus{OutboundTag: tag, Alive: err == nil, Delay: delay.Milliseconds(), HealthPing: health, LastTryTime: time.Now().Unix()}
+	if err != nil {
+		report.LastErrorReason = err.Error()
+	} else {
+		report.LastSeenTime = time.Now().Unix()
+	}
+	if b.config.Burst {
+		report.Alive = health.All > health.Fail
+		report.Delay = health.Average / int64(time.Millisecond)
+	} else {
+		report.HealthPing = nil
+	}
+	b.reports[tag] = report
+	b.mu.Unlock()
+	if b.history != nil {
+		measured := uint16(min(max(report.Delay, 0), 65535))
+		if !report.Alive {
+			measured = 65535
+		}
+		b.history.StoreURLTestHistory(tag, &adapter.URLTestHistory{Time: time.Now(), Delay: measured})
+	}
+}

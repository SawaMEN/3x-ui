diff --git a/common/tls/xui_explicit_ciphers.go b/common/tls/xui_explicit_ciphers.go
new file mode 100644
--- /dev/null
+++ b/common/tls/xui_explicit_ciphers.go
@@ -0,0 +1,33 @@
+package tls
+
+import (
+	"crypto/tls"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// This registry is consulted only for an explicitly configured cipher list.
+// Nil or empty options keep the TLS library's unchanged secure defaults.
+var xuiExplicitCipherIDs = func() map[string]uint16 {
+	ids := make(map[string]uint16)
+	for _, list := range [][]*tls.CipherSuite{tls.CipherSuites(), tls.InsecureCipherSuites()} {
+		for _, suite := range list {
+			ids[suite.Name] = suite.ID
+		}
+	}
+	return ids
+}()
+
+func xuiExplicitCipherSuites(names []string) ([]uint16, error) {
+	if len(names) == 0 {
+		return nil, nil
+	}
+	ids := make([]uint16, 0, len(names))
+	for _, name := range names {
+		id, ok := xuiExplicitCipherIDs[name]
+		if !ok {
+			return nil, E.New("unknown cipher_suite: ", name)
+		}
+		ids = append(ids, id)
+	}
+	return ids, nil
+}

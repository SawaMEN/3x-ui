package xhttp

import (
	"fmt"
	"github.com/sagernet/sing-box/option"
	"net"
	"net/http/httptest"
	"net/http/httputil"
	"net/url"
	"testing"
)

func TestXUIPanelXHTTPDownloadModes(t *testing.T) {
	addr := hStartServer(t, hOptions(t, `{"mode":"auto","path":"/split"}`), nil)
	for _, mode := range []string{"auto", "packet-up", "stream-up", "stream-one"} {
		t.Run(mode, func(t *testing.T) {
			options := hOptions(t, fmt.Sprintf(`{"mode":"packet-up","path":"/split","download":{"server":"127.0.0.1","server_port":%d,"path":"/split","mode":%q}}`, addr.Port, mode))
			hRoundTrip(t, options, nil, addr, hPayloads(t, 1200, 4000)...)
		})
	}
}
func TestXUIPanelXHTTPObfuscatedPadding(t *testing.T) {
	for _, placement := range []string{"header", "cookie", "query", "queryInHeader"} {
		for _, method := range []string{"repeat-x", "tokenish"} {
			t.Run(placement+"/"+method, func(t *testing.T) {
				raw := fmt.Sprintf(`{"mode":"packet-up","path":"/padding","x_padding_bytes":"100-1000","x_padding_obfs_mode":true,"x_padding_placement":%q,"x_padding_method":%q,"x_padding_key":"custom_padding","x_padding_header":"X-Custom-Padding"}`, placement, method)
				options := hOptions(t, raw)
				addr := hStartServer(t, options, nil)
				hRoundTrip(t, options, nil, addr, hPayloads(t, 1100)...)
			})
		}
	}
}
func TestXUIPanelPaddingPowerOfTwoAlphabet(t *testing.T) {
	value, ok := randStringFromCharset(100, "0123456789abcdef")
	if !ok || len(value) != 100 {
		t.Fatal("hex padding failed")
	}
}
func TestXUIPanelXHTTPNestedDownload(t *testing.T) {
	addr := hStartServer(t, hOptions(t, `{"mode":"auto","path":"/split"}`), nil)
	options := hOptions(t, fmt.Sprintf(`{"mode":"packet-up","path":"/split","download":{"server":"127.0.0.1","server_port":1,"path":"/unused","download":{"server":"127.0.0.1","server_port":%d,"path":"/split"}}}`, addr.Port))
	hRoundTrip(t, options, nil, addr, hPayloads(t, 1200, 4000)...)
}

func TestXUIPanelXHTTPDownloadBounds(t *testing.T) {
	node := &option.V2RayXHTTPDownloadOptions{ServerOptions: option.ServerOptions{Server: "127.0.0.1", ServerPort: 443}}
	node.Download = node
	o := option.V2RayXHTTPOptions{Download: node}
	if _, err := o.ResolveDownload(); err == nil {
		t.Fatal("cycle accepted")
	}
	node.Download = nil
	o.Mode = "stream-one"
	if _, err := o.ResolveDownload(); err == nil {
		t.Fatal("stream-one download ignored")
	}
	o.Mode = "packet-up"
	node.Mode = "invalid"
	if _, err := o.ResolveDownload(); err == nil {
		t.Fatal("invalid download mode accepted")
	}
}
func TestXUIPanelXHTTPNestedTLSDownload(t *testing.T) {
	addr := hStartServer(t, hOptions(t, `{"mode":"auto","path":"/split"}`), nil)
	target, _ := url.Parse("http://" + addr.String())
	proxy := httptest.NewUnstartedServer(httputil.NewSingleHostReverseProxy(target))
	proxy.EnableHTTP2 = true
	proxy.StartTLS()
	defer proxy.Close()
	port := proxy.Listener.Addr().(*net.TCPAddr).Port
	options := hOptions(t, fmt.Sprintf(`{"mode":"stream-up","path":"/split","download":{"server":"127.0.0.1","server_port":1,"download":{"server":"127.0.0.1","server_port":%d,"path":"/split","tls":{"enabled":true,"insecure":true}}}}`, port))
	hRoundTrip(t, options, nil, addr, hPayloads(t, 1200, 4000)...)
}

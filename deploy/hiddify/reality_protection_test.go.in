//go:build with_utls

package tls

import (
	"context"
	"crypto/ecdh"
	"crypto/ecdsa"
	"crypto/elliptic"
	"crypto/rand"
	stdtls "crypto/tls"
	"crypto/x509"
	"crypto/x509/pkix"
	"encoding/base64"
	"io"
	"math/big"
	"net"
	"testing"
	"time"

	"github.com/cloudflare/circl/sign/mldsa/mldsa65"
	"github.com/sagernet/sing-box/option"
	"github.com/sagernet/sing/common/logger"
	xreality "github.com/xtls/reality"
	xn "github.com/xtls/xray-core/common/net"
	xr "github.com/xtls/xray-core/transport/internet/reality"
)

func TestXUIPanelRealityMLDSAHandshake(t *testing.T) {
	// All endpoints are loopback. A large TLS 1.3 decoy certificate has room for the PQ extension.
	priv, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	pub := &priv.PublicKey
	template := &x509.Certificate{SerialNumber: big.NewInt(1), DNSNames: []string{"localhost"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), ExtraExtensions: []pkix.Extension{{Id: []int{1, 2, 3, 4}, Value: make([]byte, 5000)}}}
	cert, err := x509.CreateCertificate(rand.Reader, template, template, pub, priv)
	if err != nil {
		t.Fatal(err)
	}
	decoy, err := stdtls.Listen("tcp", "127.0.0.1:0", &stdtls.Config{CurvePreferences: []stdtls.CurveID{stdtls.X25519}, MinVersion: stdtls.VersionTLS13, MaxVersion: stdtls.VersionTLS13, Certificates: []stdtls.Certificate{{Certificate: [][]byte{cert}, PrivateKey: priv}}, NextProtos: []string{"h2", "http/1.1"}})
	if err != nil {
		t.Fatal(err)
	}
	defer decoy.Close()
	go func() {
		for {
			c, e := decoy.Accept()
			if e != nil {
				return
			}
			go func() { defer c.Close(); c.SetDeadline(time.Now().Add(5 * time.Second)); io.Copy(io.Discard, c) }()
		}
	}()
	key, _ := ecdh.X25519().GenerateKey(rand.Reader)
	seed := [32]byte{1, 2, 3}
	verify, _ := mldsa65.NewKeyFromSeed(&seed)
	for _, mode := range []string{"valid", "wrong-key", "missing-signature", "legacy", "xray-client", "xray-server"} {
		t.Run(mode, func(t *testing.T) {
			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
			defer cancel()
			addr := decoy.Addr().(*net.TCPAddr)
			serverOptions := option.InboundTLSOptions{Enabled: true, ServerName: "localhost", Reality: &option.InboundRealityOptions{Enabled: true, PrivateKey: base64.RawURLEncoding.EncodeToString(key.Bytes()), Handshake: option.InboundRealityHandshakeOptions{ServerOptions: option.ServerOptions{Server: "127.0.0.1", ServerPort: uint16(addr.Port)}}}}
			clientOptions := option.OutboundTLSOptions{Enabled: true, ServerName: "localhost", UTLS: &option.OutboundUTLSOptions{Enabled: true, Fingerprint: "chrome"}, Reality: &option.OutboundRealityOptions{Enabled: true, PublicKey: base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes())}}
			if mode != "legacy" {
				serverOptions.Reality.Mldsa65Seed = base64.RawURLEncoding.EncodeToString(seed[:])
				clientOptions.Reality.Mldsa65Verify = base64.RawURLEncoding.EncodeToString(verify.Bytes())
			}
			if mode == "wrong-key" {
				other := [32]byte{9}
				wrong, _ := mldsa65.NewKeyFromSeed(&other)
				clientOptions.Reality.Mldsa65Verify = base64.RawURLEncoding.EncodeToString(wrong.Bytes())
			}
			if mode == "missing-signature" {
				serverOptions.Reality.Mldsa65Seed = ""
			}
			server, err := NewRealityServer(ctx, logger.NOP(), serverOptions)
			if err != nil {
				t.Fatal(err)
			}

			client, err := NewRealityClient(ctx, logger.NOP(), "localhost", clientOptions)
			if err != nil {
				t.Fatal(err)
			}
			listener, err := net.Listen("tcp", "127.0.0.1:0")
			if err != nil {
				t.Fatal(err)
			}
			defer listener.Close()
			done := make(chan error, 1)
			go func() {
				raw, e := listener.Accept()
				if e != nil {
					done <- e
					return
				}
				defer raw.Close()
				raw.SetDeadline(time.Now().Add(5 * time.Second))
				var conn net.Conn
				if mode == "xray-server" {
					// The local decoy sends no application records; seed its deterministic probe result.
					for _, alpn := range []string{"0", "1", "2"} {
						xreality.GlobalPostHandshakeRecordsLens.Store(decoy.Addr().String()+" localhost "+alpn, []int{})
					}
					config := &xr.Config{Type: "tcp", Dest: decoy.Addr().String(), ServerNames: []string{"localhost"}, PrivateKey: key.Bytes(), ShortIds: [][]byte{make([]byte, 8)}, Mldsa65Seed: seed[:]}
					conn, e = xr.Server(raw, config.GetREALITYConfig())
				} else {
					conn, e = ServerHandshake(ctx, raw, server)
				}
				if e == nil {
					_, e = io.Copy(conn, conn)
				}
				done <- e
			}()
			raw, err := net.DialTimeout("tcp", listener.Addr().String(), time.Second)
			if err != nil {
				t.Fatal(err)
			}
			defer raw.Close()
			raw.SetDeadline(time.Now().Add(5 * time.Second))
			var conn net.Conn
			if mode == "xray-client" {
				config := &xr.Config{ServerName: "localhost", Fingerprint: "chrome", PublicKey: key.PublicKey().Bytes(), ShortId: make([]byte, 8), Mldsa65Verify: verify.Bytes()}
				conn, err = xr.UClient(raw, config, ctx, xn.TCPDestination(xn.DomainAddress("localhost"), 443))
			} else {
				conn, err = ClientHandshake(ctx, raw, client)
			}
			if mode == "wrong-key" || mode == "missing-signature" {
				if err == nil {
					conn.Close()
					t.Fatal("unverified PQ connection accepted")
				}
				return
			}
			if err != nil {
				t.Fatalf("client: %v; server: %v", err, <-done)
			}
			payload := []byte("modified sing-box REALITY ML-DSA-65")
			if _, err = conn.Write(payload); err != nil {
				t.Fatal(err)
			}
			got := make([]byte, len(payload))
			if _, err = io.ReadFull(conn, got); err != nil {
				t.Fatalf("read: %v; server: %v", err, <-done)
			}
			if string(got) != string(payload) {
				t.Fatal("payload changed")
			}
			conn.Close()
		})
	}
}

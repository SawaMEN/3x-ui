+++ b/protocol/vless/xui_preconnect.go
@@ -0,0 +1,102 @@
+package vless
+
+import (
+	"context"
+	"net"
+	"sync"
+	"time"
+)
+
+type preconnected struct {
+	conn, base net.Conn
+	expires    time.Time
+}
+
+// Each worker owns at most one transport connection; no VLESS data is sent before use.
+type preconnectPool struct {
+	ctx        context.Context
+	cancel     context.CancelFunc
+	dial       func(context.Context) (net.Conn, net.Conn, error)
+	size       int
+	once       sync.Once
+	mu         sync.Mutex
+	closed     bool
+	generation chan struct{}
+	ready      chan preconnected
+	wg         sync.WaitGroup
+}
+
+func newPreconnectPool(ctx context.Context, size int, dial func(context.Context) (net.Conn, net.Conn, error)) *preconnectPool {
+	ctx, cancel := context.WithCancel(ctx)
+	return &preconnectPool{ctx: ctx, cancel: cancel, size: size, dial: dial, ready: make(chan preconnected), generation: make(chan struct{})}
+}
+func (p *preconnectPool) Get(ctx context.Context) (net.Conn, net.Conn, error) {
+	p.once.Do(func() {
+		p.mu.Lock()
+		defer p.mu.Unlock()
+		if p.closed {
+			return
+		}
+		for i := 0; i < p.size; i++ {
+			p.wg.Add(1)
+			go p.worker()
+		}
+	})
+	for {
+		select {
+		case <-ctx.Done():
+			return nil, nil, ctx.Err()
+		case <-p.ctx.Done():
+			return nil, nil, p.ctx.Err()
+		case entry := <-p.ready:
+			if p.ctx.Err() != nil || ctx.Err() != nil {
+				entry.conn.Close()
+				continue
+			}
+			if time.Now().Before(entry.expires) {
+				return entry.conn, entry.base, nil
+			}
+			entry.conn.Close()
+		}
+	}
+}
+func (p *preconnectPool) worker() {
+	defer p.wg.Done()
+	for p.ctx.Err() == nil {
+		p.mu.Lock()
+		generation := p.generation
+		p.mu.Unlock()
+		dialCtx, cancel := context.WithTimeout(p.ctx, 30*time.Second)
+		conn, base, err := p.dial(dialCtx)
+		cancel()
+		if err == nil {
+			timer := time.NewTimer(2 * time.Minute)
+			select {
+			case <-p.ctx.Done():
+				conn.Close()
+			case <-generation:
+				conn.Close()
+			case <-timer.C:
+				conn.Close()
+			case p.ready <- preconnected{conn, base, time.Now().Add(2 * time.Minute)}:
+			}
+			timer.Stop()
+		} else if conn != nil {
+			conn.Close()
+		}
+		timer := time.NewTimer(200 * time.Millisecond)
+		select {
+		case <-p.ctx.Done():
+			timer.Stop()
+			return
+		case <-timer.C:
+		}
+	}
+}
+func (p *preconnectPool) Reset() {
+	p.mu.Lock()
+	close(p.generation)
+	p.generation = make(chan struct{})
+	p.mu.Unlock()
+}
+func (p *preconnectPool) Close() { p.cancel(); p.wg.Wait() }

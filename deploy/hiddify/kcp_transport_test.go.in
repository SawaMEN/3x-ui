package v2raykcp

import (
	"bytes"
	"context"
	"github.com/sagernet/sing-box/common/tls"
	"github.com/sagernet/sing-box/option"
	"github.com/sagernet/sing/common/logger"
	M "github.com/sagernet/sing/common/metadata"
	N "github.com/sagernet/sing/common/network"
	XN "github.com/xtls/xray-core/common/net"
	"github.com/xtls/xray-core/transport/internet"
	"github.com/xtls/xray-core/transport/internet/kcp"
	"io"
	"net"
	"testing"
	"time"
)

type echoHandler struct{}

func (echoHandler) NewConnectionEx(ctx context.Context, c net.Conn, src, dst M.Socksaddr, close N.CloseHandlerFunc) {
	go func() { defer c.Close(); io.Copy(c, c) }()
}

type udpDialer struct{ net.Dialer }

func (d udpDialer) DialContext(ctx context.Context, network string, addr M.Socksaddr) (net.Conn, error) {
	return d.Dialer.DialContext(ctx, network, addr.String())
}
func (d udpDialer) ListenPacket(ctx context.Context, addr M.Socksaddr) (net.PacketConn, error) {
	return net.ListenPacket("udp", "127.0.0.1:0")
}
func checkEcho(t *testing.T, c net.Conn) {
	t.Helper()
	defer c.Close()
	c.SetDeadline(time.Now().Add(5 * time.Second))
	data := bytes.Repeat([]byte("mKCP interoperable stream"), 500)
	if _, err := c.Write(data); err != nil {
		t.Fatal(err)
	}
	got := make([]byte, len(data))
	if _, err := io.ReadFull(c, got); err != nil {
		t.Fatal(err)
	}
	if !bytes.Equal(data, got) {
		t.Fatal("corrupted payload")
	}
}
func TestXUIPanelKCPInteroperability(t *testing.T) {
	for _, header := range []string{"none", "srtp", "utp", "wechat", "dtls", "wireguard"} {
		for _, seed := range []string{"", "secret"} {
			t.Run(header+"/"+seed, func(t *testing.T) {
				ctx := context.Background()
				o := option.V2RayKCPOptions{Legacy: true, Header: header, Seed: seed}
				server, err := NewServer(ctx, logger.NOP(), o, nil, echoHandler{})
				if err != nil {
					t.Fatal(err)
				}
				defer server.Close()
				packet, err := net.ListenPacket("udp", "127.0.0.1:0")
				if err != nil {
					t.Fatal(err)
				}
				defer packet.Close()
				go server.ServePacket(packet)
				addr := M.SocksaddrFromNet(packet.LocalAddr())
				client, err := NewClient(ctx, udpDialer{}, addr, o, nil)
				if err != nil {
					t.Fatal(err)
				}
				defer client.Close()
				conn, err := client.DialContext(ctx)
				if err != nil {
					t.Fatal(err)
				}
				checkEcho(t, conn)
				config, masks, err := buildOptions(o)
				if err != nil {
					t.Fatal(err)
				}
				memory := &internet.MemoryStreamConfig{ProtocolName: kcp.ProtocolName, ProtocolSettings: config, UdpmaskManager: masks.UDP}
				xconn, err := kcp.DialKCP(ctx, XN.UDPDestination(XN.IPAddress(net.ParseIP("127.0.0.1")), XN.Port(addr.Port)), memory)
				if err != nil {
					t.Fatal(err)
				}
				checkEcho(t, xconn)
			})
		}
	}
}
func TestXUIPanelKCPTLS(t *testing.T) {
	ctx := context.Background()
	key, cert, err := tls.GenerateCertificate(nil, nil, time.Now, "localhost", time.Now().Add(time.Hour))
	if err != nil {
		t.Fatal(err)
	}
	serverTLS, err := tls.NewServer(ctx, logger.NOP(), option.InboundTLSOptions{Enabled: true, Certificate: []string{string(cert)}, Key: []string{string(key)}})
	if err != nil {
		t.Fatal(err)
	}
	defer serverTLS.Close()
	clientTLS, err := tls.NewClient(ctx, logger.NOP(), "localhost", option.OutboundTLSOptions{Enabled: true, ServerName: "localhost", Insecure: true})
	if err != nil {
		t.Fatal(err)
	}
	o := option.V2RayKCPOptions{}
	server, err := NewServer(ctx, logger.NOP(), o, serverTLS, echoHandler{})
	if err != nil {
		t.Fatal(err)
	}
	defer server.Close()
	packet, err := net.ListenPacket("udp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	defer packet.Close()
	go server.ServePacket(packet)
	client, err := NewClient(ctx, udpDialer{}, M.SocksaddrFromNet(packet.LocalAddr()), o, clientTLS)
	if err != nil {
		t.Fatal(err)
	}
	defer client.Close()
	conn, err := client.DialContext(ctx)
	if err != nil {
		t.Fatal(err)
	}
	checkEcho(t, conn)
}

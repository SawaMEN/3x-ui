+// Пауза между НЕУДАЧНЫМИ попытками восполнения writer'а.
+//
+// Зачем. Циклы в `refill_writer_after_loss` крутились без единой задержки: при
+// мёртвом эндпоинте это до 32 идущих подряд connect'ов, каждый из которых
+// отбивается за один RTT. У одноэндпоинтных DC (1/2/3 — там ровно один
+// middle-proxy) это означает, что после сброса со стороны Telegram мы долбим
+// один и тот же адрес десятки раз в секунду, ничего этим не добиваясь.
+//
+// Почему только после НЕУДАЧИ. Успешная попытка выходит из цикла через
+// `return true`, поэтому на живом эндпоинте задержки не возникает вовсе: первый
+// же connect проходит, и восстановление остаётся мгновенным. Платит только тот
+// сценарий, где платить не жалко, — эндпоинт всё равно не отвечает.
+//
+// Почему с джиттером. Восполнения РАЗНЫХ эндпоинтов между собой не
+// дедуплицируются (ключ — пара dc+addr), и без разброса их попытки сходятся в
+// такт. Джиттер до 50% разводит их во времени; та же схема уже применяется в
+// health-пути (`health.rs`, JITTER_FRAC_NUM).
+//
+// Величины подобраны так, чтобы 16 попыток укладывались примерно в 12 секунд:
+// заметно спокойнее прежнего, но всё ещё быстрее health-пути с его базой 500 мс
+// и потолком 30 с, рассчитанного на долгую недоступность.
+const ME_REFILL_RETRY_DELAY_BASE_MS: u64 = 50;
+const ME_REFILL_RETRY_DELAY_CAP_MS: u64 = 1_500;
+const ME_REFILL_RETRY_JITTER_FRAC: u64 = 2; // джиттер до 50% от задержки
+
+// Задержка перед следующей попыткой: экспоненциальный рост с потолком плюс
+// джиттер. `failed_attempts` — сколько попыток уже провалилось (1 после первой).
+fn refill_retry_delay(failed_attempts: u32) -> Duration {
+    let shift = failed_attempts.saturating_sub(1).min(16);
+    let grown = ME_REFILL_RETRY_DELAY_BASE_MS
+        .checked_shl(shift)
+        .unwrap_or(ME_REFILL_RETRY_DELAY_CAP_MS);
+    let capped = grown.min(ME_REFILL_RETRY_DELAY_CAP_MS);
+    let jitter_span = (capped / ME_REFILL_RETRY_JITTER_FRAC).max(1);
+    let jitter = rand::rng().random_range(0..=jitter_span);
+    Duration::from_millis(capped.saturating_add(jitter))
+}

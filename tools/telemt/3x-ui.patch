+        let d9 = refill_retry_delay(9).as_millis() as u64;
+        assert!(
+            (ME_REFILL_RETRY_DELAY_BASE_MS..=ME_REFILL_RETRY_DELAY_BASE_MS * 3 / 2).contains(&d1),
+            "первая задержка вне ожидаемого окна: {d1}"
+        );
+        assert!(
+            d2 >= ME_REFILL_RETRY_DELAY_BASE_MS * 2,
+            "рост не идёт: {d2}"
+        );
+        let cap_with_jitter = ME_REFILL_RETRY_DELAY_CAP_MS
+            + ME_REFILL_RETRY_DELAY_CAP_MS / ME_REFILL_RETRY_JITTER_FRAC;
+        assert!(d9 <= cap_with_jitter, "потолок не держится: {d9}");
+    }

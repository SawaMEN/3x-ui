+            let d = refill_retry_delay(n).as_millis() as u64;
+            let cap_with_jitter = ME_REFILL_RETRY_DELAY_CAP_MS
+                + ME_REFILL_RETRY_DELAY_CAP_MS / ME_REFILL_RETRY_JITTER_FRAC;
